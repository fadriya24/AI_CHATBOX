# Google Gemini API Key (Keep this secret! Never put real keys in .env.example)
# 1. Create a free API key at: https://aistudio.google.com/app/apikey
# 2. Copy this file to .env.local and replace the placeholder below
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the default Gemini model (defaults to gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest
